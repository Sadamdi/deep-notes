{
  "name": "deep-notes",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Deep Notes: shared, source-grounded AI notebooks for student study groups",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./frontend --filter ./backend run dev",
    "dev:frontend": "pnpm --filter @deep-notes/frontend dev",
    "dev:backend": "pnpm --filter @deep-notes/backend dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "type-check": "pnpm -r run type-check",
    "test": "pnpm -r --if-present run test",
    "ci": "pnpm lint && pnpm type-check && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
