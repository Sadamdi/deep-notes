{
  "name": "@deep-notes/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "lint": "eslint src tests",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "eval:grounding": "tsx --env-file-if-exists=.env scripts/evaluate-grounding.ts",
    "ai:smoke": "tsx --env-file-if-exists=.env scripts/ai-smoke.ts"
  },
  "dependencies": {
    "@deep-notes/shared": "workspace:*",
    "@electric-sql/pglite": "^0.3.15",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jszip": "^3.10.2",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "unpdf": "^2.2.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "vitest": "^5.1.1"
  }
}
