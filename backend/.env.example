# Copy to backend/.env (gitignored). Never commit real values and never paste them into chat, issues or PRs.
# Local development must use a database you can lose (host localhost, or a separate development project).

NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL with the pgvector extension).
# Percent-encode special characters in the password. Do not put sslmode in the URL; use DATABASE_SSL.
DATABASE_URL=postgresql://deepnotes:change-me@localhost:5432/deepnotes
# "require" for hosted databases such as Supabase, "disable" for a local one
DATABASE_SSL=disable

# At least 32 random characters (for example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=

# Uploaded files (private directory, never served directly)
UPLOAD_DIR=./uploads

# AI providers, tried in this order for text generation
AI_PROVIDER_ORDER=gemini,openai-compat
# One or more Gemini API keys, comma separated (no spaces needed)
GEMINI_API_KEYS=
# Optional fallback: any OpenAI-compatible endpoint (base URL ends with /v1)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
# Model ids are chosen by a real API call during setup (task T-012); leave empty until then
AI_TEXT_MODEL=
AI_FALLBACK_TEXT_MODEL=
# Embeddings stay on one model; changing it means re-embedding every chunk
AI_EMBED_MODEL=gemini-embedding-001
AI_EMBED_DIMENSIONS=768
